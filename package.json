{
  "name": "agentarch",
  "version": "0.1.0",
  "description": "Runtime Architectural Drift Detection and Conformance Checking for LLM Multi-Agent Systems via OpenTelemetry Traces",
  "main": "src/agentarch/index.js",
  "scripts": {
    "test": "node experiments/run_evaluation.js",
    "eval": "node experiments/run_evaluation.js",
    "bench": "node experiments/benchmark_latency.js",
    "test:unit": "node tests/test_drift_operators.js && node tests/test_live_integration.js && node tests/test_workflow.js && node tests/test_statistics.js",
    "eval:live": "node experiments/run_live_evaluation.js",
    "eval:metadata": "node experiments/instrumentation_sensitivity.js",
    "eval:workflow": "node experiments/run_multiagent_evaluation.js",
    "analyze:workflow": "node experiments/analyze_multiagent.js",
    "bench:paths": "node experiments/benchmark_paths.js",
    "bench:supplement": "node experiments/benchmark_supplement.js",
    "analyze:exclusions": "node experiments/analyze_exclusions.js",
    "analyze:consolidated": "node experiments/analyze_consolidated.js",
    "analyze:queries": "node experiments/analyze_queries.js",
    "analyze:final-audit": "node experiments/analyze_final_audit.js",
    "paper:assets": "node experiments/build_paper_assets.js"
  },
  "keywords": [
    "multi-agent-systems",
    "llm",
    "runtime-verification",
    "opentelemetry",
    "architectural-drift"
  ],
  "author": "Leonardo Baca Calsin & German Arturo Chipana Jeronimo (UNSA)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leonardobaca7/agentarch.git"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1"
  }
}
